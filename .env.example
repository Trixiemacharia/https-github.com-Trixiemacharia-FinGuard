# Django
SECRET_KEY=replace-with-a-random-secret
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
REFRESH_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=False
FRONTEND_URL=http://localhost:5173

# Current production settings use MySQL. Local automated tests use SQLite.
DB_NAME=fintech
DB_USER=fintech
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=3306

# Redis (cache, short-lived WebSocket tickets, and Channels)
REDIS_URL=redis://127.0.0.1:6379
CACHE_REDIS_URL=redis://127.0.0.1:6379/1
CHANNEL_REDIS_URL=redis://127.0.0.1:6379/2
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# Google sign-in (required by current settings import)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Auth and OTP
FAILED_LOGIN_MAX_ATTEMPTS=5
FAILED_LOGIN_LOCKOUT_SECONDS=900
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@example.test
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=10

# Set SMS_BACKEND=apps.users.sms.ConsoleSMSBackend only with DEBUG=True.
# Production: SMS_BACKEND=apps.users.sms.AfricasTalkingBackend and set credentials below.
SMS_BACKEND=
AT_USERNAME=
AT_API_KEY=

# Dotted callable accepting an OnboardingProfile and returning "clear" or
# {"decision": "review", "flags": [...]} for manual review. Empty fails closed.
# Local duplicate-account and onboarding-completeness checks. Configure an
# external provider separately for sanctions, PEP, identity/document, or AML checks.
ONBOARDING_RISK_SCREENING_BACKEND=apps.users.risk_screening.screen_application

# Daraja sandbox (leave credentials blank to disable live provider access)
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_BASE_URL=
MPESA_CALLBACK_SECRET=replace-with-random-callback-secret
MPESA_CALLBACK_ALLOWED_IPS=
MPESA_MIN_AMOUNT=1
MPESA_MAX_AMOUNT=150000
MPESA_QUERY_AFTER_SECONDS=60
MPESA_EXPIRY_SECONDS=900

# Optional wallet rule overrides are configured in Django settings as
# WALLET_SETTINGS, for example REVIEW_THRESHOLD, BLOCK_THRESHOLD, and WEIGHTS.
